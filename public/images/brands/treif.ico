                    <path fill="#013a71" d="M77 82c-1.3 0-2.6-.5-3.5-1.5l-72-72c-1.9-2-1.9-5.2.1-7.1 1.9-1.9 5-1.9 6.9 0l72 72c2 1.9 2 5.1.1 7.1-1 1-2.3 1.5-3.6 1.5z" />
